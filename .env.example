# نشانی اتصال PostgreSQL. در production از TLS مناسب استفاده کنید.
FORMS_DATABASE_URL=postgres://forms:forms@127.0.0.1:5432/forms?sslmode=disable

# سرویس به‌صورت پیش‌فرض فقط روی loopback گوش می‌دهد.
FORMS_HTTP_ADDR=127.0.0.1:8080
FORMS_DATA_DIR=./var
FORMS_TIMEZONE=Asia/Tehran
FORMS_LOG_LEVEL=info
FORMS_DB_MAX_CONNS=6
FORMS_DB_MIN_CONNS=0
FORMS_SESSION_IDLE=12h
FORMS_SESSION_ABSOLUTE=168h
FORMS_SHUTDOWN_TIMEOUT=15s
FORMS_PASSWORD_HASH_LIMIT=2s
FORMS_MAX_UPLOAD_BYTES=104857600

# فقط اگر برنامه پشت reverse proxy اجرا می‌شود، شبکهٔ همان proxy را صریحاً وارد کنید.
# FORMS_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# اختیاری؛ برای فرم‌هایی که Turnstile را فعال می‌کنند هر دو مقدار لازم است.
# FORMS_TURNSTILE_SITE_KEY=your-site-key
# FORMS_TURNSTILE_SECRET=your-secret-key

# فقط برای توسعهٔ محلی روی HTTP فعال کنید. در production حذف شود.
FORMS_INSECURE_COOKIE=true
