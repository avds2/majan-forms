[Unit]
Description=Clean temporary Persian Forms sessions and uploads
After=postgresql.service

[Service]
Type=oneshot
User=forms
Group=forms
EnvironmentFile=/etc/forms/forms.env
ExecStart=/usr/local/bin/forms cleanup
StateDirectory=forms
StateDirectoryMode=0700
WorkingDirectory=/var/lib/forms
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
TasksMax=32
MemoryMax=256M
CPUWeight=25
IOWeight=25
